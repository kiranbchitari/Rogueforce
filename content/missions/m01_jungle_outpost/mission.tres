[resource]
script = ExtResource("3_wecyj")
id = &"m01_jungle_outpost"
display_name = "Jungle Outpost"
codename = "GREEN HELL"
description = "Iron Legion forces have dug into the Kaliga river basin. Push through the swamp, take out the bunker line and stop the Warden siege tank before it reaches the village."
environment = ExtResource("2_v67cd")
layout_file = "res://content/missions/m01_jungle_outpost/layout.txt"
legend = Dictionary[String, String]({
"H": "pickup:medkit",
"L": "pickup:pickup_laser",
"M": "pickup:pickup_mg",
"S": "pickup:pickup_spread",
"U": "pickup:extra_life",
"a": "enemy:infantry",
"b": "enemy:explosive_barrel",
"d": "enemy:drone",
"g": "enemy:grenadier",
"h": "enemy:heavy",
"s": "enemy:sniper",
"t": "enemy:turret"
})
triggers = Array[ExtResource("4_xqurq")]([SubResource("Resource_pdj1v"), SubResource("Resource_ipqf3"), SubResource("Resource_vrl1u")])
boss = ExtResource("1_o6xx1")
par_time = 300.0
