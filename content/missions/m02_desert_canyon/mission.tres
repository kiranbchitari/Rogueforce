"H": "pickup:medkit",
"L": "pickup:pickup_laser",
"S": "pickup:pickup_spread",
"a": "enemy:infantry",
"b": "enemy:explosive_barrel",
"d": "enemy:drone",
"r": "enemy:shield_trooper",
"t": "enemy:turret",
"v": "enemy:raider_buggy",
"x": "enemy:scorpion"
})
triggers = Array[ExtResource("4_g1dx0")]([SubResource("Resource_as3mb"), SubResource("Resource_rxilm")])
boss = ExtResource("1_gc14t")
par_time = 220.0
