[resource]
script = ExtResource("3_t8y2d")
id = &"m02_desert_canyon"
display_name = "Canyon Convoy"
codename = "DUST DEVIL"
description = "Raiders allied with the Iron Legion are moving weapons through the Scorpion Desert under gunship cover. Break the convoy and bring down the Hornet."
